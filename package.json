  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace=apps/web run dev",
    "build": "npm --workspace=apps/web run build",
    "start": "npm --workspace=apps/web run start",
    "test": "vitest run",
    "test:phone": "vitest run apps/web/tests/phone.test.ts",
