    "simulate:pilot": "tsx scripts/simulate-pilot.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@types/pg": "^8.23.1",
    "dotenv": "^16.4.7",
    "pg": "^8.23.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
